{
  "dataset": "mousePMHC",
  "description": "Paired binary benchmark for tissue-H2-I-specific presentation preference of unmodified Mus musculus 9-mer peptides.",
  "input": "data\\processed\\iedb_mouse_tissue_specificity_pairs.csv.gz",
  "train_output": "data\\mousePMHC\\mousePMHC_train.csv.gz",
  "test_output": "data\\mousePMHC\\mousePMHC_test.csv.gz",
  "summary_output": "data\\mousePMHC\\mousePMHC_summary.csv",
  "min_pairs_filter": "> 200 pairs per tissue-H2 group",
  "test_pairs_per_tissue_mhc": 100,
  "random_seed": 20260704,
  "n_tissue_hla_groups": 24,
  "train_rows": 13532,
  "test_rows": 4800,
  "train_pairs": 6766,
  "test_pairs": 2400,
  "labels": {
    "1": "reported in target tissue-H2",
    "0": "same UniProt and H2, reported in other tissue but not target tissue-H2"
  },
  "filters": [
    "Mus musculus peptide source",
    "Mus musculus host",
    "MHC-I",
    "H2 restriction",
    "positive IEDB qualitative measurement",
    "molecule_parent_uniprot_id available",
    "unmodified standard amino-acid peptide",
    "peptide length = 9"
  ]
}