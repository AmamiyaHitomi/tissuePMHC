{
  "dataset": "tissuePMHC",
  "description": "Paired binary benchmark dataset for tissue-HLA-specific presentation preference of unmodified human 9-mer HLA-I peptides.",
  "input": "data\\processed\\iedb_tissue_specificity_pairs.csv.gz",
  "train_output": "data\\tissuePMHC\\tissuePMHC_train.csv.gz",
  "test_output": "data\\tissuePMHC\\tissuePMHC_test.csv.gz",
  "summary_output": "data\\tissuePMHC\\tissuePMHC_summary.csv",
  "min_pairs_filter": "> 500 pairs per tissue-HLA group",
  "test_pairs_per_tissue_hla": 100,
  "random_seed": 20260704,
  "n_tissue_hla_groups": 44,
  "train_rows": 96972,
  "test_rows": 8800,
  "train_pairs": 48486,
  "test_pairs": 4400,
  "labels": {
    "1": "reported in target tissue-HLA",
    "0": "same UniProt and HLA, reported in other tissue but not target tissue-HLA"
  },
  "filters": [
    "human peptide source",
    "human host",
    "MHC-I",
    "four-digit HLA allele",
    "positive IEDB qualitative measurement",
    "molecule_parent_uniprot_id available",
    "unmodified standard amino-acid peptide",
    "peptide length = 9"
  ]
}